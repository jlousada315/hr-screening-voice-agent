# Copy this file to `.env` and fill in the REQUIRED values for your setup.
#   cp .env.example .env
# "Required" below means: the feature does not work without it. Anything marked
# optional has a sane default and can be left as-is for local dev.

# ─── Owner — optional ─────────────────────────────────────────────────────────
# Who the rep represents. Defaults to config/owner.md, then config/example.md.
# Use an absolute path when mounting the file in a container.
# OWNER_FILE=/run/secrets/owner.md

# ─── Brain (Groq through Pydantic AI) — REQUIRED ──────────────────────────────────
# The model is a Groq-prefixed Pydantic AI model string.
LLM_MODEL=groq/openai/gpt-oss-120b
# gpt-oss only: low (default) | medium | high | none. Lower is faster and cheaper per turn.
# LLM_REASONING_EFFORT=low
# Get a key at console.groq.com → API Keys.
GROQ_API_KEY=

# ─── ElevenLabs (speech: STT + TTS) — REQUIRED for the call UI ────────────────
# Only the JSON text API (POST /turn) works without these. The key needs the
# text_to_speech + speech_to_text permissions. On the free tier, TTS rejects
# "library" voices (402) — use a voice from your own account's voice list.
ELEVENLABS_API_KEY=
# The neutral, professional voice the Rep speaks in (NOT a clone of the owner's voice).
# e.g. River (SAz9YHcvj6GT2YYXdXww) — a premade account voice that works on free tier.
ELEVENLABS_VOICE_ID=
# Optional model overrides (defaults shown; rarely needed).
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5

# ─── Chat API — optional ──────────────────────────────────────────────────────
# Shared secret required on POST /turn when the API is publicly exposed.
# Leave blank for local dev.
API_SHARED_SECRET=
# Comma-separated allowed CORS origins for the web UI.
CORS_ORIGINS=http://localhost:3000

# ─── Web UI — REQUIRED for the browser app ────────────────────────────────────
# Base URL of the chat API the web UI calls.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── PostHog — optional, shared by API and browser ─────────────────────────────
# Project API Key from PostHog → Project settings. Enables backend AI capture
# and browser analytics. Blank disables both.
POSTHOG_API_KEY=
POSTHOG_API_URL=https://eu.i.posthog.com
# Headless end-of-call feedback: a survey with a 1–5 rating question and an open-text
# question. All three IDs required. Leave blank until reviewed.
NEXT_PUBLIC_POSTHOG_FEEDBACK_SURVEY_ID=
NEXT_PUBLIC_POSTHOG_FEEDBACK_RATING_QUESTION_ID=
NEXT_PUBLIC_POSTHOG_FEEDBACK_COMMENT_QUESTION_ID=

# AI telemetry environment; set production on deployed API instances.
# Development/test events are excluded from production monitoring.
DEPLOYMENT_ENVIRONMENT=development
